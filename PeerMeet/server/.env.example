# Server Configuration
PORT=5001

# Allowed client origin (for CORS)
CLIENT_URL=http://localhost:5173

# Deepgram API key for live transcription
DEEPGRAM_API_KEY=

# Google Gemini API key for the AI interview assistant (server-side only)
GEMINI_API_KEY=
# REQUIRED in practice: the code's built-in default (gemini-2.5-flash) has
# been retired by Google ("no longer available to new users") and will 404
# on every call if this is left unset. gemini-3.6-flash is confirmed working.
GEMINI_MODEL=gemini-3.6-flash

# TURN/STUN credentials for WebRTC NAT traversal (metered.ca / Metered.live).
# Never hardcode these in client source — the client fetches the
# active server list over the authenticated socket connection instead.

# Preferred: Metered's credential API key. The server fetches freshly-issued
# TURN credentials on demand (cached a few hours) instead of storing a
# long-lived username/password pair. Find this under Metered dashboard > API keys.
METERED_API_KEY=
# Metered subdomain the API key belongs to (defaults to mirracle.metered.live)
METERED_DOMAIN=

# Legacy static fallback — only used if METERED_API_KEY is unset or the fetch fails.
TURN_URLS=turn:global.relay.metered.ca:80,turn:global.relay.metered.ca:80?transport=tcp,turn:global.relay.metered.ca:443,turns:global.relay.metered.ca:443?transport=tcp
TURN_USERNAME=
TURN_CREDENTIAL=
