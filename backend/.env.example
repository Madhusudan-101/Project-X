# Copy this file to .env and fill in your Supabase credentials
# Get them from: Supabase Dashboard → Settings → API

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Required for RLS-bound College Portal queries (get_user_supabase). Falls back to
# the service-role key if unset, which bypasses RLS — always set this in real envs.
SUPABASE_ANON_KEY=your-anon-key-here

# Backend host/port
HOST=127.0.0.1
PORT=8000

# CORS allow-list for the browser-facing frontend(s). Comma-separated
# origins (scheme + host + port, no trailing slash). Localhost origins
# are already whitelisted by default for dev — set this in production to
# grant your real dashboard domain access. Example:
#   FRONTEND_ORIGINS=https://app.mirracle.ai,https://staging.mirracle.ai
FRONTEND_ORIGINS=

# GitHub Personal Access Token (optional – raises rate limit from 60 → 5000/hr)
# Generate at: https://github.com/settings/tokens
GITHUB_PAT=

# Google Gemini API Key (required for AI analysis)
# Generate at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Shared secret for the dashboard ↔ PeerMeet integration.
# - The FastAPI backend signs a short-lived JWT with this secret (see
#   /candidate/peer-session-token) that PeerMeet's signaling server verifies
#   synchronously to attach student identity to a participant.
# - The SAME secret authenticates PeerMeet's server-to-server webhook to
#   /internal/peer-reports (sent as `Authorization: Bearer <secret>`).
# This is NOT the Supabase JWT secret. Use a fresh long random value
# (e.g. `openssl rand -hex 48`). The identical value must exist in
# PeerMeet/server/.env as PEERMEET_SHARED_SECRET.
PEERMEET_SHARED_SECRET=replace-with-a-long-random-value

# ── Online Assessment ────────────────────────────────────────────────
# Code judge. "off" (default) stores code but can't Run/Submit; "piston" is the
# production setting (see deploy/piston/README.md); "local" is DEV/TEST ONLY — it
# runs candidate code on this machine WITHOUT isolation and also needs
# OA_ALLOW_LOCAL_JUDGE=1.
OA_JUDGE_BACKEND=off
OA_PISTON_URL=
# OA_PISTON_TOKEN=               # sent as the Authorization header if Piston sits behind a proxy
# OA_ALLOW_LOCAL_JUDGE=1
# OA_JUDGE_CONCURRENCY=4         # simultaneous sandbox runs before requests queue
# OA_JUDGE_QUEUE_WAIT=20         # seconds a request waits for a free slot before a "busy" error
# OA_MAX_SUBMISSIONS_PER_QUESTION=20

# Demo/dev only: let the first candidate to open a drive's OA auto-create a default
# template when the company hasn't built one. Leave unset in production.
# OA_AUTOPROVISION_DEFAULT=1

# Email (invites, reminders, submission receipts). Optional: without these the OA
# still works and invited candidates see it on their dashboard.
RESEND_API_KEY=
OA_EMAIL_FROM=                   # e.g. "Mirracle <assessments@yourdomain.com>"
APP_BASE_URL=                    # public site URL used in email links, e.g. https://app.example.com

# ── AI voice interview (see /ai-interviewer) ────────────────────────────────
# LiveKit Cloud project used for the interview rooms. Same values the agent worker uses.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Must equal the worker's AI_INTERVIEW_AGENT_NAME (explicit dispatch).
AI_INTERVIEW_AGENT_NAME=mirracle-interviewer
# Shared secret the agent sends as `Authorization: Bearer <secret>` to
# /internal/ai-interview-reports. Use a fresh random value (openssl rand -hex 48);
# it must NOT be the PeerMeet secret.
AI_INTERVIEW_SHARED_SECRET=replace-with-a-long-random-value
# Cost guardrails.
AI_INTERVIEW_DAILY_LIMIT=3
AI_INTERVIEW_MAX_MINUTES=20
