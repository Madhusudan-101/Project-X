# LiveKit Cloud project (same project as the backend's LIVEKIT_* values)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Explicit dispatch name. Must equal the backend's AI_INTERVIEW_AGENT_NAME.
AI_INTERVIEW_AGENT_NAME=mirracle-interviewer

# Where finished reports are sent, and the shared secret for that endpoint.
# MIRRACLE_WEBHOOK_URL is the FastAPI backend's public base URL (no trailing slash).
MIRRACLE_WEBHOOK_URL=http://localhost:8000
AI_INTERVIEW_SHARED_SECRET=replace-with-the-same-value-as-the-backend

# Model providers
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-flash-latest
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# Hard cap per interview (the backend also sends this in the room metadata)
AI_INTERVIEW_MAX_MINUTES=20

# Optional company Q&A. Run `python ingest.py` once to build the store;
# without it the interviewer works fine but cannot answer company questions.
# COMPANY_PDF_PATH=./company.pdf
# CHROMA_DIR=./chroma_store
