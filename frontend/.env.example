# Copy this file to .env.local
VITE_API_BASE_URL=http://localhost:8000

# URL of the separately-deployed PeerMeet client (Vite app).
# The dashboard opens this in a new tab with a short-lived token appended
# as ?token=... so PeerMeet can attach the caller's student identity.
VITE_PEERMEET_URL=http://localhost:5173

# Used only for the Google sign-in redirect (frontend never talks to
# Supabase directly otherwise). Get these from Supabase Dashboard >
# Project Settings > API. The anon key is safe to expose in the browser.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
